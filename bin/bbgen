#!/bin/sh
# Run bbgen from a checkout without installing it (symlink this onto your PATH). It builds the release binary
# first when the sources changed (cargo does nothing, quickly, when they didn't).
set -e
root="$(dirname "$(readlink -f "$0")")/.."
cargo build --release --quiet --manifest-path "$root/Cargo.toml" >&2
exec "$root/target/release/bbgen" "$@"
